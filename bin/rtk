#!/bin/bash
# RTK (Rust Token Killer) - Truncates noisy terminal output preserving exit codes

if [ "$#" -eq 0 ]; then
    echo "Usage: rtk <command>"
    exit 1
fi

TMP_FILE=$(mktemp)
"$@" > "$TMP_FILE" 2>&1
EXIT_CODE=$?

LINES=$(wc -l < "$TMP_FILE" | tr -d ' ')

if [ "$LINES" -gt 150 ]; then
    head -n 50 "$TMP_FILE"
    echo -e "\n... [RTK: $((LINES - 100)) lines truncated to save context tokens] ...\n"
    tail -n 50 "$TMP_FILE"
else
    cat "$TMP_FILE"
fi

rm -f "$TMP_FILE"
exit "$EXIT_CODE"
